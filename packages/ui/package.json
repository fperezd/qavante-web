{
  "name": "@tooxs/ui",
  "version": "0.1.0",
  "description": "Design system reutilizable de Tooxs (Capa 1) — primitivos agnósticos de dominio + tokens themeables.",
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": [
    "**/*.css"
