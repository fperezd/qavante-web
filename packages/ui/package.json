{
  "name": "@tooxs-digital/ui",
  "version": "0.1.0",
  "description": "Design system reutilizable de Tooxs (Capa 1) — primitivos agnósticos de dominio + tokens themeables.",
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tooxs-digital/ui.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./src/styles/tokens.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "bunchee",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "@dnd-kit/core": "^6",
    "@dnd-kit/sortable": "^10",
    "@dnd-kit/utilities": "^3",
    "@tanstack/react-table": "^8",
    "react": ">=19",
    "react-dom": ">=19",
    "recharts": "^3"
  },
  "dependencies": {
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "lucide-react": "^1",
    "sonner": "^2",
    "tailwind-merge": "^3"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6",
    "@dnd-kit/sortable": "^10",
    "@dnd-kit/utilities": "^3",
    "@tanstack/react-table": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bunchee": "^6.11.0",
    "recharts": "^3",
    "typescript": "^5"
  }
}
