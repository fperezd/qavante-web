    "./tokens.css": "./src/styles/tokens.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "recharts": "^3",
    "@tanstack/react-table": "^8",
    "@dnd-kit/core": "^6",
    "@dnd-kit/sortable": "^10",
    "@dnd-kit/utilities": "^3"
  },
  "dependencies": {
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "lucide-react": "^1",
    "sonner": "^2",
    "tailwind-merge": "^3"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6",
    "@dnd-kit/sortable": "^10",
    "@dnd-kit/utilities": "^3",
    "@tanstack/react-table": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "recharts": "^3",
    "typescript": "^5"
  }
