FROM node:24.19.0-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
ENV HUSKY=0
RUN npm ci

FROM node:24.19.0-bookworm-slim AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# QAS no debe apuntar a api.qavante.com (Fly/prod). Vacío = el cliente
# muestra config_missing y no pega a Tooxs. Cuando exista ca-qavante-api-qas,
# pasar --build-arg NEXT_PUBLIC_API_URL=https://<fqdn-api-qas>
ARG NEXT_PUBLIC_API_URL=
ARG NEXT_PUBLIC_APP_ENV=qas
# Site key PÚBLICA (mismo valor que wrangler.toml / deploy-cloudflare.yml).
# Sin esto el widget de Turnstile no se renderiza y /registro en QAS queda
# fail-closed contra la API.
ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADpQkYv0x2Mvz7Xp
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_APP_ENV=$NEXT_PUBLIC_APP_ENV
ENV NEXT_PUBLIC_TURNSTILE_SITE_KEY=$NEXT_PUBLIC_TURNSTILE_SITE_KEY
ENV HUSKY=0
# Mismos flags que wrangler.toml [vars] (prod Cloudflare). Sin esto el
# default es false y Cobrar/Caja/Pagar muestran "todavía no disponible".
ENV NEXT_PUBLIC_FF_CASH_FLOW_REPORT=true \
    NEXT_PUBLIC_FF_BANK_MOVEMENT_CLASSIFICATION=true \
