{
  "name": "qavante-web-scaffold",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . && npm run qa:user-copy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --project unit",
    "test:storybook": "vitest run --project storybook",
    "test:coverage": "vitest run --project unit --coverage",
    "e2e": "playwright test",
    "e2e:decision-brief": "playwright test --config=playwright.decision-brief.config.ts",
    "e2e:real": "playwright test --config=playwright.real.config.ts",
    "smoke": "playwright test --config=playwright.smoke.config.ts",
    "generate:api": "openapi-typescript docs/contracts/openapi.snapshot.json -o src/lib/api/types.ts",
    "generate:api:sync": "node scripts/openapi-snapshot.mjs sync",
    "contract:check": "node scripts/openapi-snapshot.mjs check",
    "build:cloudflare": "opennextjs-cloudflare build",
    "size:check": "node scripts/check-bundle-size.mjs",
    "lighthouse": "lhci autorun",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes --only-changed",
    "qa:rediseno": "node scripts/qa-rediseno-lint.mjs",
    "qa:user-copy": "node scripts/check-user-facing-copy.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-query-devtools": "^5.100.9",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "4.4.0",
    "lucide-react": "^1.14.0",
    "next": "^16.3.4",
    "next-intl": "^4.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.75.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@lhci/cli": "^0.15.1",
    "@opennextjs/cloudflare": "1.20.2",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-vitest": "^10.4.0",
    "@storybook/nextjs-vite": "^10.4.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "chromatic": "^16.10.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-storybook": "^10.4.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.4",
    "msw": "^2.14.6",
    "msw-storybook-addon": "^2.0.7",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.60.0",
    "prettier": "3.8.3",
    "shadcn": "^4.7.0",
    "storybook": "^10.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.0.13",
    "vitest": "4.1.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
