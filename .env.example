NEXT_PUBLIC_API_URL=https://api.qavante.com
NEXT_PUBLIC_APP_ENV=development

# MSW mocking (sólo dev/test, ver ADR-0005). Apuntar API_URL a same-origin
# para que las cookies funcionen. Ejemplo dev local:
#   NEXT_PUBLIC_API_URL=http://localhost:3000
#   NEXT_PUBLIC_API_MOCKING=enabled
NEXT_PUBLIC_API_MOCKING=

# Cloudflare Turnstile (anti-bot del signup). Site key PÚBLICA (no es secreto);
# la secret la valida el backend. Sin esta key el widget no renderiza. Pon la del
# proyecto (la real está en el panel de Cloudflare / en las vars del deploy).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
